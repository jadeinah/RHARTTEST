local function safeFind(parent, ...)
    local current = parent
    for _, name in ipairs({...}) do
        current = current and current:FindFirstChild(name)
        if not current then return nil end
    end
    return current
end

local function safeWaitChain(parent, timeout, ...)
    local current = parent
    for _, name in ipairs({...}) do
        if not current then return nil end
        local success, result = pcall(function() return current:WaitForChild(name, timeout or 5) end)
        current = success and result or nil
    end
    return current
end

